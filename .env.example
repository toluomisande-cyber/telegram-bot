# Telegram Bot Configuration
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Your numeric Telegram User ID (only this user can interact with the bot).
# You can find your ID by sending a message to @userinfobot on Telegram.
OWNER_CHAT_ID=123456789

# Groq API Configuration
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Email Configuration (Optional - needed if using /email)
# Sign up at https://resend.com, verify your domain, and grab your API key
RESEND_API_KEY=re_your_resend_api_key_here
# The 'from' address — must be on a domain you've verified in Resend
SMTP_USER=you@yourdomain.com
